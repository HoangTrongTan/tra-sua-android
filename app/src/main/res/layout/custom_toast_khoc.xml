        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/corner_16dp"
        >
        <TextView
            android:layout_width="250dp"
            android:layout_height="100dp"
            android:text="Sai tên đăng nhập rùi !!"
